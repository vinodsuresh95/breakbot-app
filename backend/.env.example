# Copy to .env and fill in values
ANTHROPIC_API_KEY=sk-ant-...

# Email (SMTP) — required for actual send; Gmail app password works
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@breakbot.io
SMTP_PASSWORD=your-app-password
EMAIL_FROM=hello@breakbot.io
EMAIL_FROM_NAME=Vinod — BreakBot

# Airtable waitlist (optional)
AIRTABLE_TOKEN=patXXXX
AIRTABLE_BASE_ID=appXXXX

# Dashboard API protection — REQUIRED in production
DASHBOARD_API_KEY=change-me-to-a-long-random-string

# Daily automation — comma-separated prospect IDs to auto-run each morning
AUTO_OUTREACH_PROSPECT_IDS=

# CORS — frontend URL in production
FRONTEND_ORIGIN=http://localhost:5173
