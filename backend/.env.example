# Local Client Audit Edition — keep this file off GitHub
APP_ENV=development

ANTHROPIC_API_KEY=sk-ant-...

# Protect dashboard agents + audit APIs (set a long random value)
DASHBOARD_API_KEY=change-me-to-a-long-random-string

# Frontend origin (Vite default in this repo is port 3000)
FRONTEND_ORIGIN=http://localhost:3000

# Bind address — default 127.0.0.1 (loopback only). Do not use 0.0.0.0 for client audits.
HOST=127.0.0.1
PORT=8001

# Optional model overrides
# CHAT_MODEL=claude-sonnet-5
# FAST_MODEL=claude-haiku-4-5-20251001

# Email (SMTP) — optional for outreach; not required for audits
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@breakbot.io
SMTP_PASSWORD=your-app-password
EMAIL_FROM=hello@breakbot.io
EMAIL_FROM_NAME=Vinod — BreakBot

# Airtable waitlist (optional)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
